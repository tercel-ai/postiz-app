{
  "name": "postiz-frontend",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev -p 4200",
    "dev:local": "dotenv -e ../../.env -- sh -c 'next dev -p 4200 --experimental-https -H $(node -e \"console.log(new URL(process.env.FRONTEND_URL).hostname)\")'",
    "build": "next build",
    "build:sentry": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start -p ${FRONTEND_PORT:-4200}",
    "pm2": "bash ../../scripts/pm2-start-app.sh frontend",
    "pm2:prod": "bash ../../scripts/pm2-start-app.sh frontend-prod"
  },
